rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isMatch(chatId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)/matches/$(get(/databases/$(database)/documents/chats/$(chatId)).data.otherUserId)
        );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isUser(userId);

      match /likes/{likedUserId} {
        allow create, update, delete: if isUser(userId);
        allow read: if signedIn()
          && (request.auth.uid == userId || request.auth.uid == likedUserId);
      }

      match /receivedLikes/{likerUserId} {
        allow create: if signedIn()
          && request.auth.uid == likerUserId;

        allow read, delete: if isUser(userId);
      }

      match /passes/{passedUserId} {
        allow read, write: if isUser(userId);
      }

      match /matches/{matchUserId} {
        allow read, write: if signedIn()
          && (request.auth.uid == userId || request.auth.uid == matchUserId);
      }

      match /dailyMessageCounts/{counterId} {
        allow read, write: if isUser(userId);
      }
    }

    match /matches/{matchId} {
      allow read, write: if signedIn();
    }

    match /chats/{chatId} {
      allow read, write: if signedIn();

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }
  }
}
