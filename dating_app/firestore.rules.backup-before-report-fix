rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.users;
    }

    function isMatchedWith(otherUserId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)/matches/$(otherUserId)
        );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isUser(userId);

      match /likes/{likedUserId} {
        allow create, update, delete: if isUser(userId);

        allow read: if signedIn()
          && (
            request.auth.uid == userId ||
            request.auth.uid == likedUserId
          );
      }

      match /receivedLikes/{likerUserId} {
        allow create: if signedIn()
          && request.auth.uid == likerUserId;

        allow read, delete: if isUser(userId);
      }

      match /passes/{passedUserId} {
        allow read, write: if isUser(userId);
      }

      match /matches/{matchUserId} {
        allow read, write: if signedIn()
          && (
            request.auth.uid == userId ||
            request.auth.uid == matchUserId
          );
      }

      match /dailyMessageCounts/{counterId} {
        allow read, write: if isUser(userId);
      }
    }

    match /matches/{matchId} {
      allow read, write: if signedIn();
    }

    match /chats/{chatId} {
      allow read: if isChatMember(chatId);

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2;

      allow update: if isChatMember(chatId);

      allow delete: if isChatMember(chatId);

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.users;

        allow update, delete: if isChatMember(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
