rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.users;
    }

    match /users/{userId} {

      allow read: if signedIn();
      allow create, update, delete: if isUser(userId);

      match /likes/{likedUserId} {
        allow read: if signedIn()
          && (
            request.auth.uid == userId ||
            request.auth.uid == likedUserId
          );

        allow create, update, delete: if isUser(userId);
      }

      match /receivedLikes/{likerId} {
        allow create: if signedIn()
          && request.auth.uid == likerId
          && request.resource.data.userId == request.auth.uid;

        allow read, delete: if isUser(userId);
      }

      match /passes/{passedUserId} {
        allow read, write: if isUser(userId);
      }

      match /matches/{matchUserId} {
        allow read, write: if signedIn()
          && (
            request.auth.uid == userId ||
            request.auth.uid == matchUserId
          );
      }

      match /blockedUsers/{blockedUserId} {
        allow read, write: if isUser(userId);
      }

      match /dailyMessageCounts/{counterId} {
        allow read, write: if isUser(userId);
      }
    }

    match /matches/{matchId} {
      allow read, write: if signedIn()
        && (
          (
            request.resource != null &&
            request.auth.uid in request.resource.data.users
          )
          ||
          (
            resource != null &&
            request.auth.uid in resource.data.users
          )
        );
    }

    match /chats/{chatId} {

      allow read: if isChatMember(chatId);

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2;

      allow update, delete: if isChatMember(chatId);

      match /messages/{messageId} {

        allow read: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.users;

        allow update: if isChatMember(chatId)
          && resource.data.senderId == request.auth.uid;

        allow delete: if isChatMember(chatId);
      }
    }
  }
}
